generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id        String   @id @default(cuid())
  serial    String   @unique
  name      String
  kind      String   @default("environment") // "environment" | "bioelectric"
  tokenHash String?
  lastSeen  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plants    Plant[]
  readings  Reading[]
  bioReadings BioReading[]
}

model Plant {
  id              String   @id @default(cuid())
  name            String
  species         String?
  location        String?
  notes           String?
  deviceId        String?
  moistureDryRaw  Int      @default(52000)
  moistureWetRaw  Int      @default(22000)
  targetMoisture  Int      @default(48)
  minLightLux     Int      @default(250)
  maxSoilTempC    Float    @default(30)
  minSoilTempC    Float    @default(10)
  memorySummary   String   @default("")
  conversationSummary String @default("")
  lastCompactedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  device          Device?  @relation(fields: [deviceId], references: [id])
  readings        Reading[]
  alerts          Alert[]
  messages        ChatMessage[]
  memories        Memory[]
  photos          PlantPhoto[]
  calendarEvents  CalendarEvent[]
  mlSamples       MLTrainingSample[]
  bioReadings     BioReading[]
  bioResponses    BioResponseEvent[]
}

model Reading {
  id                String   @id @default(cuid())
  deviceId          String
  plantId           String?
  recordedAt        DateTime @default(now())
  soilMoistureRaw   Int?
  soilMoisturePct   Float?
  soilTempC         Float?
  airTempC          Float?
  airHumidityPct    Float?
  pressureHpa       Float?
  lightLux          Float?
  batteryMv         Int?
  wifiRssi          Int?
  firmwareVersion   String?
  device            Device   @relation(fields: [deviceId], references: [id])
  plant             Plant?   @relation(fields: [plantId], references: [id])

  @@index([deviceId, recordedAt])
  @@index([plantId, recordedAt])
}

model Alert {
  id        String   @id @default(cuid())
  plantId   String
  severity  String
  title     String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  plant     Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId, status, createdAt])
}

model Memory {
  id        String   @id @default(cuid())
  plantId   String
  kind      String
  content   String
  createdAt DateTime @default(now())
  plant     Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  plantId   String
  role      String
  content   String
  createdAt DateTime @default(now())
  plant     Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId, createdAt])
}

model PlantPhoto {
  id              String   @id @default(cuid())
  plantId         String
  title           String
  objectKey       String   @unique
  mimeType        String
  sizeBytes       Int
  takenAt         DateTime?
  analysis        String   @default("")
  observations    String   @default("[]")
  recommendations String   @default("[]")
  healthScore     Int?
  confidence      Float    @default(0)
  colorTags       String   @default("[]")
  colorAnomalyScore Float  @default(0)
  colorAnomalyConfidence Float @default(0)
  colorFindings   String   @default("[]")
  diseaseLabel    String?
  diseaseConfidence Float  @default(0)
  diseaseHealthy  Boolean?
  diseasePredictions String @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  plant           Plant    @relation(fields: [plantId], references: [id])

  @@index([plantId, createdAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  plantId     String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  category    String    @default("check")
  priority    String    @default("medium")
  status      String    @default("planned")
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  plant       Plant     @relation(fields: [plantId], references: [id])

  @@index([plantId, startsAt])
  @@index([plantId, status, startsAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MLTrainingSample {
  id          String   @id @default(cuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sampledAt   DateTime
  features    String
  label       Float
  labelSource String   @default("photo")
  photoId     String?
  prediction  Float?
  createdAt   DateTime @default(now())

  @@index([plantId, sampledAt])
}

model MLModelVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  trainedAt   DateTime @default(now())
  sampleCount Int
  weights     String
  metrics     String?
  isActive    Boolean  @default(false)
}

model PairingCode {
  id           String    @id @default(cuid())
  code         String    @unique
  deviceSerial String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// Une fenêtre d'acquisition bioélectrique agrégée par le 2e Pico (biopotentiel
// tige↔sol). Le firmware échantillonne à haute fréquence, calcule des features
// par fenêtre + une forme d'onde sous-échantillonnée, et POST le tout ici.
model BioReading {
  id             String   @id @default(cuid())
  deviceId       String
  plantId        String?
  recordedAt     DateTime @default(now())
  firmwareVersion String?
  sampleRateHz   Int
  windowSeconds  Float
  sampleCount    Int
  channel        String?
  gain           Float?   // gain du front-end analogique, null si inconnu
  baselineRaw    Float?
  baselineUv     Float?
  meanUv         Float?
  rmsUv          Float?
  rmsRaw         Float?
  stdRaw         Float?
  p2pRaw         Float?
  minRaw         Float?
  maxRaw         Float?
  slopeRawPerSec Float?
  spikeCount     Int?
  zeroCrossRate  Float?
  bandLowEnergy  Float?
  bandMidEnergy  Float?
  bandHighEnergy Float?
  activityIndex  Float?   // 0-1 normalisé côté serveur (relatif à la baseline plante)
  qualityFlag    String?  // "ok" | "saturated" | "flatline" | "noisy"
  waveform       String?  // JSON: forme d'onde décimée (points 0-1)
  batteryMv      Int?
  wifiRssi       Int?
  device         Device   @relation(fields: [deviceId], references: [id])
  plant          Plant?   @relation(fields: [plantId], references: [id])

  @@index([deviceId, recordedAt])
  @@index([plantId, recordedAt])
}

// Résultat de l'analyse long-terme: la plante a-t-elle réagi à un évènement
// (arrosage détecté via un saut d'humidité du Pico environnemental) ?
model BioResponseEvent {
  id            String   @id @default(cuid())
  plantId       String
  eventType     String   // "watering" | "light" | "temp" | "unknown"
  eventAt       DateTime
  baselineRms   Float
  responseRms   Float
  responseRatio Float    // responseRms / baselineRms
  latencyMin    Float?   // minutes entre l'évènement et le pic d'activité bio
  reacted       Boolean
  confidence    Float
  detail        String?  // JSON libre
  createdAt     DateTime @default(now())
  plant         Plant    @relation(fields: [plantId], references: [id])

  @@unique([plantId, eventType, eventAt])
  @@index([plantId, eventAt])
}
