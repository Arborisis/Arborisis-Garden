DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arborisis"
DEVICE_INGEST_TOKEN="change-me-device-token"
OPENROUTER_API_KEY=""
# Modele principal (agent, chat, calibration). Defaut: anthropic/claude-opus-4.8 (le plus capable).
OPENROUTER_MODEL="anthropic/claude-opus-4.8"
# Modele vision pour l'analyse photo (defaut: OPENROUTER_MODEL puis anthropic/claude-opus-4.8).
OPENROUTER_VISION_MODEL=""
# Modele des insights tableau de bord (defaut: anthropic/claude-sonnet-4.6).
OPENROUTER_INSIGHTS_MODEL=""
# Modele de compaction de conversation (defaut: anthropic/claude-haiku-4.5).
OPENROUTER_COMPACT_MODEL=""
# Raisonnement etendu (adaptive thinking) sur agent/vision/calibration: low|medium|high|off (defaut: high).
OPENROUTER_REASONING_EFFORT="high"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Arborisis Garden"

# Railway Object Storage (S3-compatible)
STORAGE_ENDPOINT="https://your-bucket.railway.app"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"
STORAGE_BUCKET="arborisis-photos"

# PWA Push Notifications (VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-as-VAPID_PUBLIC_KEY"
PUSH_SECRET="change-me-push-secret"

# ML auto-training threshold (number of new samples before auto-train triggers)
ML_AUTO_TRAIN_THRESHOLD="10"

# Analyse bioelectrique (2e Pico). Tous optionnels — defauts sains dans lib/bioelectric/config.ts.
# Le 2e Pico POST vers /api/bioelectric (meme DEVICE_INGEST_TOKEN que la telemetrie).
BIO_WATERING_JUMP_PCT="8"        # saut min d'humidite (%) qui compte comme arrosage
BIO_WATERING_WINDOW_MIN="20"     # fenetre (min) du saut d'humidite
BIO_BASELINE_WINDOW_MIN="30"     # fenetre bio avant l'evenement (baseline)
BIO_RESPONSE_WINDOW_MIN="60"     # fenetre bio apres l'evenement (reponse)
BIO_REACTION_RATIO="1.3"         # responseRms/baselineRms a partir duquel "la plante a reagi"
BIO_MIN_SAMPLES="3"              # fenetres bio minimales de chaque cote pour decider
BIO_ACTIVITY_SATURATION="4"      # activite=1 a partir de 4x la baseline RMS de la plante

# Detection de maladies par modele ONNX (classifieur CNN, optionnel). Voir models/README.md.
# Sans URL ni PATH la classification est simplement desactivee (l'analyse couleur + LLM reste active).
# Modele recommande: MobileNetV2 PlantVillage 38 classes (genere via scripts/convert-plant-disease-model.py).
# Production: heberger le .onnx et renseigner l'URL.
PLANT_DISEASE_MODEL_URL=""
# Recommande sur Railway: cle de l'objet dans le bucket S3 prive existant (charge via client S3 authentifie).
PLANT_DISEASE_MODEL_BUCKET_KEY=""     # ex: models/plant-disease-mobilenetv2.onnx
# Alternative locale (prioritaire), ex apres conversion:
PLANT_DISEASE_MODEL_PATH=""           # ex: ./models/plant-disease-mobilenetv2.onnx
# Dossier de cache du modele telecharge (defaut: <tmp>/arborisis-models). Sur Railway, pointer vers un volume persistant evite un re-telechargement a chaque deploiement.
PLANT_DISEASE_MODEL_DIR=""
# Pretraitement. Pour le MobileNetV2 recommande: NORMALIZE=minus1_1.
PLANT_DISEASE_INPUT_SIZE="224"        # cote de l'image carree attendue par le modele
PLANT_DISEASE_NORMALIZE="minus1_1"    # imagenet | 0_1 | minus1_1 (MobileNetV2 = minus1_1)
PLANT_DISEASE_LAYOUT="nchw"           # nchw | nhwc
PLANT_DISEASE_APPLY_SOFTMAX="1"       # 1 si le modele sort des logits, 0 s'il sort deja des probabilites
PLANT_DISEASE_TOPK="3"
# Surcharge optionnelle des labels (sinon PlantVillage 38 classes par defaut):
# PLANT_DISEASE_LABELS='["Tomato___healthy", ...]'   ou   PLANT_DISEASE_LABELS_PATH="./models/labels.json"

# Railway production:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
